{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "items3d:escudo_v01",
      "item": "items3d:escudo_v01",
      "render_controllers": ["controller.render.item_default"],
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/entity/attachable/escudo_v01",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.escudo_v01"
      },
      "animations": {
        "first_person_hold": "animation.escudo_v01.first_person_hold",
        "third_person_hold": "animation.escudo_v01.third_person_hold",
        "sneaking_hold": "animation.escudo_v01.sneaking_hold"
      },
      "scripts": {
        "animate": [
          {
            "first_person_hold": "query.is_first_person && !query.is_sneaking"
          },
          {
            "third_person_hold": "!query.is_first_person && !query.is_sneaking"
          },
          {
            "sneaking_hold": "query.is_sneaking"
          }
        ]
      }
    }
  }
}
